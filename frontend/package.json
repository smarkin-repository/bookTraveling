{
  "name": "booktravaling-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:prototype": "vite prototype --config vite.config.ts --host 127.0.0.1 --port 5174 --strictPort",
    "build:prototype": "tsc --project prototype/tsconfig.json && vite build prototype --config vite.config.ts",
    "build": "tsc --noEmit && vite build"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "agentation": "3.1.2",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
